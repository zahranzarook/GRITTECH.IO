rules_version = '2';

// GRIT member data.
// - A member can read only their own records.
// - A member can create their profile once, always on the free plan.
// - A member can change only their name.
// - Purchases, projects, enrolments and plan upgrades are written only by GRIT
//   (Cloud Functions / admin), never from the browser.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    match /users/{uid} {
      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['name', 'email', 'plan', 'createdAt'])
        && request.resource.data.plan == 'free'
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && request.resource.data.createdAt == request.time;

      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 80;

      allow delete: if false;

      match /purchases/{id}   { allow read: if isOwner(uid); allow write: if false; }
      match /projects/{id}    { allow read: if isOwner(uid); allow write: if false; }
      match /enrollments/{id} { allow read: if isOwner(uid); allow write: if false; }
    }

    // Everything else is closed.
    match /{document=**} { allow read, write: if false; }
  }
}
